# Переменные для docker compose. Скопируйте в .env (он в .gitignore) и поменяйте пароли:
#   cp .env.example .env
# Значения ниже годятся только для локального запуска, в проде задайте свои.

# Адрес, по которому браузер открывает дашборд. По нему Keycloak подписывает токены (iss)
# и проверяет redirect_uri. Если меняете WEB_HOST_PORT или открываете не с localhost, поменяйте и его.
PUBLIC_URL=http://localhost:8000

# PostgreSQL. Пароль задаётся при первом создании тома: у существующего тома он уже записан внутри,
# поэтому для старых данных оставьте прежний (example) или пересоздайте том: docker compose down -v
POSTGRES_PASSWORD=example

# Администратор Keycloak: http://localhost:8000/auth/admin/
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=change-me

# Тестовые пользователи realm degradations (keycloak/realm-degradations.json)
KC_READER_PASSWORD=reader
KC_EDITOR_PASSWORD=editor
